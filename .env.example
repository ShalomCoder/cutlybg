# CutlyBG configuration (server-side only, never exposed to the browser)

# BGNinja API key. The public BGNinja endpoint does not require one, but if
# BGNinja issues a key for your integration, set it here and it will be sent
# as an Authorization header on the proxied request.
BGNINJA_API_KEY=

# BGNinja endpoint. Override if BGNinja moves or you use a private instance.
BGNINJA_API_URL=https://bgninja.com/api/remove